<div class="community-container">
    <button class="create-post-btn" id="create-btn">
        Create new post
    </button>
    <div id="post-form">
        <form action="/" method="post">
            <img src="" id="user-photo" class="skeleton-placeholder">
            <div class="img-label-container">
                <label for="input-file" class="select-img-btn">Choose image</label>
            </div>
            <div class="input-section">
                <input type="file" accept="image/jpeg, image/png, image/jpg" id="input-file" required>
                <label for="title"></label>
                <input placeholder="Title" type="text" name="title" id="title-post" required>
                <label for="description"></label>
                <textarea placeholder="Provide a description." name="description" rows="4" id="description-post"
                    required></textarea>
                <div class="btn-div">
                    <button id="create-post-btn">Post</button>
                    <button id="cancel-post-btn">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>